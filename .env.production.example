# Template for running the LOCAL conversion worker against PRODUCTION.
#
# This is NOT your normal .env — your normal .env stays pointed at your
# local dev database, untouched. This separate file only exists so
# `php artisan conversion:work-local --env=production` (and
# `conversion:install-local-worker --env=production`) can reach the real
# production database and storage from your own computer.
#
# Setup, once:
#   1. Copy this file:  copy .env.production.example .env.production
#   2. Fill in the five DB_* values and the four R2_* values below with
#      the real ones from your Laravel Cloud project's environment
#      variables page (Laravel Cloud dashboard -> your app -> Environment).
#      APP_KEY must be copied too, exactly as-is from there.
#   3. Never commit this file — .env.production is already in .gitignore,
#      the same as .env.
#
# Then run either of these FROM THE jupyterdocs PROJECT FOLDER:
#   php artisan conversion:work-local --env=production
#   php artisan conversion:install-local-worker --env=production

APP_ENV=production
APP_KEY=
APP_DEBUG=false

# Same Postgres your production site uses — copy DB_HOST, DB_PORT,
# DB_DATABASE, DB_USERNAME and DB_PASSWORD from Laravel Cloud exactly.
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

QUEUE_CONNECTION=database
CACHE_STORE=database

# Same Cloudflare R2 bucket production uploads/downloads real files from.
RESOURCE_FILE_DISK=r2
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ACCOUNT_ID=
R2_BUCKET=jupyterdocs-private
R2_REGION=auto

LOCAL_CONVERSION_QUEUE=local-conversion
